# Security
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>


<IfModule mod_headers.c>

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Send a secure referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Force HTTPS (only if your entire site uses HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Basic Content Security Policy
    Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; font-src 'self' https: data:; style-src 'self' https: 'unsafe-inline'; script-src 'self' https: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https:; frame-ancestors 'self';"

</IfModule>

